<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="NumberPicker">
        <attr name="value" format="integer" />
        <attr name="minValue" format="integer|float" />
        <attr name="maxValue" format="integer|float" />
        <attr name="step" format="integer|float" />
        <attr name="textSize" format="dimension" />
    </declare-styleable>
    <declare-styleable name="SeekBar">
        <attr name="sbMinValue" format="float" /> <!-- Defines minValue attribute -->
        <attr name="sbMaxValue" format="float" /> <!-- Defines maxValue attribute -->
        <attr name="sbStep" format="float" /> <!-- Defines step attribute -->
        <attr name="sbValue" format="float" /> <!-- Defines value attribute -->
        <attr name="suffix" format="string" /> <!-- Defines suffix attribute -->
        <attr name="sbTextSize" format="dimension" /> <!-- Defines textSize attribute -->
        <attr name="colorSecondary" format="color" /> <!-- Defines colorSecondary attribute -->
    </declare-styleable>

    <declare-styleable name="AppTheme">
        <attr name="themeColorPrimary" format="color" />
        <attr name="themeColorPrimaryDark" format="color" />
        <attr name="themeColorAccent" format="color" />
    </declare-styleable>

    <!--
      Theme-preset color roles. Set by the generated overlays in theme_overlays.xml, one
      per preset, applied at runtime via ThemeManager.applyTheme(). Values are computed by
      ThemePreset (contrast-enforced), never hand-picked here.

      Naming follows the surface/on-surface convention: `themeOnX` is what you draw ON TOP
      of `themeX`. Using a background role where a foreground is meant (or vice versa) is
      how you get invisible text, so pick by role, not by which hex looks nicer.
    -->
    <attr name="themeBackground" format="color" />
    <attr name="themeSurface" format="color" />
    <attr name="themeSurfaceVariant" format="color" />
    <attr name="themeAccent" format="color" />

    <attr name="themeOnBackground" format="color" />
    <attr name="themeOnSurface" format="color" />
    <attr name="themeOnSurfaceVariant" format="color" />
    <attr name="themeOnAccent" format="color" />

    <!-- Accent adjusted to keep 3:1 against themeSurface. Use for accent-colored
         components sitting on a card; use themeAccent on themeBackground. -->
    <attr name="themeAccentOnSurface" format="color" />
    <!-- Darkened accent for low-emphasis fills, borders and inactive tracks. -->
    <attr name="themeAccentDim" format="color" />
    <attr name="themeDivider" format="color" />

    <!-- Elevation ramp for raised cards and dialogs, each step further from themeSurface. -->
    <attr name="themeSurfaceContainer" format="color" />
    <attr name="themeSurfaceContainerHigh" format="color" />
    <attr name="themeSurfaceContainerHighest" format="color" />

    <attr name="extraKeysButtonTextColor" format="reference" />
    <attr name="extraKeysButtonActiveTextColor" format="reference" />
    <attr name="extraKeysButtonBackgroundColor" format="reference" />
    <attr name="extraKeysButtonActiveBackgroundColor" format="reference" />

    <attr name="gamingSurfaceColor" format="color" />
    <attr name="gamingCardSubtitleColor" format="color" />
    <attr name="gamingPopupColor" format="color" />
    <attr name="gamingToolbarColor" format="color" />
</resources>
