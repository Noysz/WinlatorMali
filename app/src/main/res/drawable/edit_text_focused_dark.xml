<?xml version="1.0" encoding="utf-8"?>
<!-- Port dari drawable-hdpi/edit_text_focused_dark.9.png (dihapus). Ukur PNG asli:
     inset 5px@hdpi = 3.3dp, radius 5px = 3.3dp, stroke 2px = 1.3dp.
     Isi field pakai themeBackground (peran paling gelap) — di PNG lama variant
     dark isinya #000000 di atas dialog #424242, jadi kesannya "cekung".

     DINORMALISASI: PNG ini satu-satunya yg geometrinya beda dari 5 edit_text lain
     (radius 8px = 5.3dp, inset 4/3/4/4px = 2.7/2.0/2.7/2.7dp) — kelihatan digambar
     tangan terpisah, bukan variasi yg disengaja. Di sini disamain ke 3.3dp/3.3dp
     biar 6 state edit_text ga geser-geser waktu fokus pindah. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="3.3dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/themeBackground" />
        <stroke android:width="1.3dp" android:color="?attr/themeAccentOnSurface" />
        <corners android:radius="3.3dp" />
    </shape>
</inset>
