<?xml version="1.0" encoding="utf-8"?>
<!-- Port dari drawable-hdpi/content_dialog_background.9.png (dihapus).
     Warna dulu ke-bake di pixel jadi ga bisa ikut preset; sekarang lewat ?attr/.
     Geometri hasil ukur PNG asli: inset 15px@hdpi = 10dp, radius 5px = 3.3dp.
     inset 10dp = margin panel dari tepi window (dialog-nya windowFullscreen).
     InsetDrawable.getPadding() nambahin inset ke padding anak, jadi padding
     konten 10dp dari 9-patch lama ke-reproduksi tanpa <padding> manual.

     SUDUT: radius 3.3dp diganti chamfer @dimen/cut_corner_large — panel gede dapet
     potongan lebih panjang dari kontrol kecil biar chamfer-nya kebaca sebagai bentuk,
     bukan sebagai sudut yg keserempet. Detail kenapa bukan <shape>/<vector>: javadoc
     CutCornerDrawable. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:inset="10dp">
    <com.winlator.cmod.widget.CutCornerDrawable
        app:cutFillColor="?attr/themeSurface"
        app:cutSize="@dimen/cut_corner_large" />
</inset>
