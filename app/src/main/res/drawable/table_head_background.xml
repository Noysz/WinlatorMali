<?xml version="1.0" encoding="utf-8"?>
<!-- Port dari drawable-hdpi/table_head_background.9.png (dihapus). Ukur PNG asli:
     TANPA inset, TANPA radius (nempel di grid tabel), fill #0289D1 = warna accent,
     bevel 2px = 1.3dp: atas+kiri lebih terang (#4EADDF), bawah+kanan lebih gelap (#016092).
     Rasio terang/gelap-nya di-ekspres jadi overlay putih/hitam 30% biar ikut accent
     preset apa pun, bukan 3 hex mati. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeAccent" />
        </shape>
    </item>
    <item android:gravity="top|fill_horizontal" android:height="1.3dp">
        <shape android:shape="rectangle">
            <solid android:color="#4CFFFFFF" />
        </shape>
    </item>
    <item android:gravity="left|fill_vertical" android:width="1.3dp">
        <shape android:shape="rectangle">
            <solid android:color="#4CFFFFFF" />
        </shape>
    </item>
    <item android:gravity="bottom|fill_horizontal" android:height="1.3dp">
        <shape android:shape="rectangle">
            <solid android:color="#4C000000" />
        </shape>
    </item>
    <item android:gravity="right|fill_vertical" android:width="1.3dp">
        <shape android:shape="rectangle">
            <solid android:color="#4C000000" />
        </shape>
    </item>
</layer-list>
