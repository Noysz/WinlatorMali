<?xml version="1.0" encoding="utf-8"?>
<!-- Port dari drawable-hdpi/button_neutral_normal.9.png (dihapus). Ukur PNG asli:
     inset 5px@hdpi = 3.3dp, radius 5px = 3.3dp, strip bawah 6px = 4dp
     dengan warna = fill x 0.84 (bevel "tombol timbul").
     x0.84 ga punya peran tema sendiri, jadi dipakai overlay hitam 16% (#29000000):
     hasilnya proporsional buat SEMUA 18 preset, bukan hex mati satu warna.

     SUDUT: radius 3.3dp diganti chamfer (potong 45 derajat) @dimen/cut_corner_small.
     <shape> ga bisa motong sudut — <corners> selalu busur — jadi bentuknya
     CutCornerDrawable, di-inflate dari nama kelasnya sbg tag. aapt2 GA validasi
     nama tag drawable, jadi typo di tag lolos build dan baru meledak waktu inflate.
     Strip bevel ikut di-inset kiri/kanan @dimen/button_bevel_inset DAN sudut bawahnya
     dipotong setinggi strip: tanpa itu strip full-width nongol keluar chamfer di dua
     sudut bawah. Turunan angkanya di dimens.xml. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:inset="3.3dp">
    <layer-list>
        <item>
            <com.winlator.cmod.widget.CutCornerDrawable
                app:cutFillColor="?attr/themeSurfaceVariant"
                app:cutSize="@dimen/cut_corner_small" />
        </item>
        <item
            android:gravity="bottom|fill_horizontal"
            android:height="@dimen/button_bevel_height"
            android:left="@dimen/button_bevel_inset"
            android:right="@dimen/button_bevel_inset">
            <com.winlator.cmod.widget.CutCornerDrawable
                app:cutFillColor="#29000000"
                app:cutSizeBottomLeft="@dimen/button_bevel_height"
                app:cutSizeBottomRight="@dimen/button_bevel_height" />
        </item>
    </layer-list>
</inset>
