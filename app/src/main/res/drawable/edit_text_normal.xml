<?xml version="1.0" encoding="utf-8"?>
<!-- Port dari drawable-hdpi/edit_text_normal.9.png (dihapus). Ukur PNG asli:
     inset 5px@hdpi = 3.3dp, radius 5px = 3.3dp, stroke 2px = 1.3dp.
     Isi field pakai themeBackground (peran paling gelap). PNG varian TERANG ini
     dulu isinya #FFFFFF; setelah Fase 3 semua preset gelap, jadi putih mati bakal
     nyilaukan dan ga ikut preset.

     DI-DROP: PNG asli punya garis dalam 2px #E8E8E8 di sisi atas (bekas shadow
     "cekung" ala Material 2015). <shape> ga bisa naruh inner shadow, dan bikin
     tiruannya pakai layer tambahan cuma nambah 1 layer buat efek yg ga keliatan
     di background gelap. Sengaja dibuang, bukan kelupaan.

     SUDUT: radius 3.3dp diganti chamfer (potong 45 derajat) @dimen/cut_corner_small.
     <shape> ga bisa motong sudut — <corners> selalu busur — jadi bentuknya
     CutCornerDrawable, di-inflate dari nama kelasnya sbg tag. aapt2 GA validasi
     nama tag drawable, jadi typo di tag lolos build dan baru meledak waktu inflate. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:inset="3.3dp">
    <com.winlator.cmod.widget.CutCornerDrawable
        app:cutFillColor="?attr/themeBackground"
        app:cutSize="@dimen/cut_corner_small"
        app:cutStrokeColor="?attr/themeOnSurfaceVariant"
        app:cutStrokeWidth="1.3dp" />
</inset>
